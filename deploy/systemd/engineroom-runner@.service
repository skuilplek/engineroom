[Unit]
Description=Engineroom runner for %i
Requires=engineroom-runner@%i.socket
After=engineroom-runner@%i.socket

[Service]
Type=simple
User=%i
Group=%i
ExecStart=/usr/local/bin/engineroom-runner
Restart=on-failure
RestartSec=1
# ~ is the home of User=. %h is /root for a system service.
WorkingDirectory=~
Environment=PATH=/usr/local/bin:/usr/bin:/bin
Environment=ENGINEROOM_PEERCRED=/usr/local/bin/engineroom-peercred
Environment=ENGINEROOM_HUB_USER=engineroom
UMask=0077
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
