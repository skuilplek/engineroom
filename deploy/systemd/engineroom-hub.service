[Unit]
Description=Engineroom hub
After=network-online.target
Wants=network-online.target

[Service]
User=engineroom
Group=engineroom
ExecStart=/usr/local/bin/engineroom-hub
EnvironmentFile=-/etc/engineroom/hub.env
Environment=ENGINEROOM_LISTEN=127.0.0.1:8787
Environment=ENGINEROOM_SESSION_SECRET_FILE=/var/lib/engineroom/session.secret
Environment=ENGINEROOM_PAM_HELPER=/usr/local/bin/engineroom-pam-auth
Environment=ENGINEROOM_PEERCRED=/usr/local/bin/engineroom-peercred
Environment=ENGINEROOM_CTL=/usr/local/bin/engineroom-ctl
Environment=ENGINEROOM_ADMIN_CTL=/usr/local/bin/engineroom-admin
Environment=ENGINEROOM_AGENTS_FILE=/var/lib/engineroom/agents.json
Environment=ENGINEROOM_CATALOG_FILE=/var/lib/engineroom/catalog.json
Environment=ENGINEROOM_SOCKET_DIR=/run/engineroom
Environment=ENGINEROOM_WEB_DIST=/usr/local/share/engineroom/web
WorkingDirectory=/var/lib/engineroom
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/engineroom
Restart=on-failure

[Install]
WantedBy=multi-user.target
