#!/bin/bash
# Start update.sh from the checkout recorded by deploy/install.sh.
# The hub is the only caller, via sudo, after it has checked the
# administrator's password. The script runs in its own systemd unit so
# restarting the hub does not kill it.
set -euo pipefail

if [[ "$(id -u)" -ne 0 ]]; then
  echo "must run as root" >&2
  exit 1
fi

# The hub service mounts the system read-only, and sudo stays in that mount
# namespace. systemd-run needs the host namespace to reach systemd.
if [[ "${ENGINEROOM_UPDATE_NS:-}" != "host" ]]; then
  self_mnt="$(readlink /proc/self/ns/mnt 2>/dev/null || true)"
  init_mnt="$(readlink /proc/1/ns/mnt 2>/dev/null || true)"
  if [[ -n "$self_mnt" && -n "$init_mnt" && "$self_mnt" != "$init_mnt" ]]; then
    export ENGINEROOM_UPDATE_NS=host
    exec nsenter -t 1 -m -- "$0" "$@"
  fi
fi

checkout_file="${ENGINEROOM_CHECKOUT_FILE:-/etc/engineroom/checkout}"
log_file="${ENGINEROOM_UPDATE_LOG:-/var/lib/engineroom/update.log}"
status_file="${ENGINEROOM_UPDATE_STATUS:-/var/lib/engineroom/update.status}"
runtime="/run/engineroom-update"

if [[ ! -f "$checkout_file" ]]; then
  echo "checkout is not recorded" >&2
  exit 1
fi
IFS= read -r checkout < "$checkout_file" || true
if [[ ! "$checkout" =~ ^/[^[:cntrl:]]+$ ]]; then
  echo "invalid checkout" >&2
  exit 1
fi
case "$checkout" in
  *"/../"* | *"/.." | "/.."*)
    echo "invalid checkout" >&2
    exit 1
    ;;
esac
if [[ ! -d "$checkout" || ! -f "$checkout/update.sh" ]]; then
  echo "update.sh is not in the checkout" >&2
  exit 1
fi
if ! id engineroom >/dev/null 2>&1; then
  echo "engineroom user is missing" >&2
  exit 1
fi

mkdir -p /var/lib/engineroom "$runtime"
chmod 0700 "$runtime"
exec 9>"$runtime/lock"
if ! flock -n 9; then
  echo "update is already running" >&2
  exit 1
fi
if systemctl is-active --quiet engineroom-update.service; then
  echo "update is already running" >&2
  exit 1
fi
systemctl reset-failed engineroom-update.service >/dev/null 2>&1 || true

: > "$log_file"
printf 'running\n' > "$status_file"
chown engineroom:engineroom "$log_file" "$status_file"
chmod 0640 "$log_file" "$status_file"

wrapper="$runtime/run.sh"
cat > "$wrapper" <<'EOF'
#!/bin/bash
set -uo pipefail
bash "$ENGINEROOM_UPDATE_SCRIPT" >> "$ENGINEROOM_UPDATE_LOG" 2>&1
code=$?
if [[ "$code" -eq 0 ]]; then
  printf 'ok\n%d\n' "$code" > "$ENGINEROOM_UPDATE_STATUS"
else
  printf 'failed\n%d\n' "$code" > "$ENGINEROOM_UPDATE_STATUS"
fi
chown engineroom:engineroom "$ENGINEROOM_UPDATE_LOG" "$ENGINEROOM_UPDATE_STATUS" 2>/dev/null || true
chmod 0640 "$ENGINEROOM_UPDATE_LOG" "$ENGINEROOM_UPDATE_STATUS" 2>/dev/null || true
exit "$code"
EOF
chmod 0755 "$wrapper"

script="${checkout}/update.sh"
if ! systemd-run \
  --unit=engineroom-update \
  --collect \
  --quiet \
  --description="Engineroom update" \
  --working-directory="$checkout" \
  --setenv="ENGINEROOM_UPDATE_SCRIPT=${script}" \
  --setenv="ENGINEROOM_UPDATE_LOG=${log_file}" \
  --setenv="ENGINEROOM_UPDATE_STATUS=${status_file}" \
  /bin/bash "$wrapper"; then
  printf 'failed\n1\n' > "$status_file"
  chown engineroom:engineroom "$log_file" "$status_file" 2>/dev/null || true
  chmod 0640 "$log_file" "$status_file" 2>/dev/null || true
  echo "could not start the update" >&2
  exit 1
fi
