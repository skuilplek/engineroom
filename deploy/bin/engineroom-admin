#!/bin/bash
# Create a Linux account or remove it from engineroom-users.
# The hub is the only caller, via sudo. Password for add is one line on stdin.
set -euo pipefail

action="${1:-}"
user="${2:-}"
hub_env="${ENGINEROOM_HUB_ENV:-/etc/engineroom/hub.env}"

if [[ ! "$user" =~ ^[a-zA-Z_][a-zA-Z0-9_-]{0,31}$ ]]; then
  echo "invalid username" >&2
  exit 1
fi

admin=""
if [[ -f "$hub_env" ]]; then
  admin="$(sed -n 's/^ENGINEROOM_ADMIN=//p' "$hub_env" | head -n 1 | tr -d '[:space:]')"
fi

if [[ "$user" == "root" || "$user" == "engineroom" || ( -n "$admin" && "$user" == "$admin" ) ]]; then
  echo "must not change this account" >&2
  exit 1
fi

if id "$user" >/dev/null 2>&1; then
  uid="$(id -u "$user")"
  if (( uid < 1000 )); then
    echo "must not change this account" >&2
    exit 1
  fi
fi

if [[ "$(id -u)" -ne 0 ]]; then
  echo "must run as root" >&2
  exit 1
fi

case "$action" in
  add)
    IFS= read -r password || true
    if [[ -z "${password}" || "$password" == *$'\n'* ]]; then
      echo "password is empty" >&2
      exit 1
    fi
    if ! id "$user" >/dev/null 2>&1; then
      useradd --create-home --shell /bin/bash "$user"
    fi
    uid="$(id -u "$user")"
    if (( uid < 1000 )); then
      echo "must not change this account" >&2
      exit 1
    fi
    printf '%s:%s\n' "$user" "$password" | chpasswd
    usermod -aG engineroom-users "$user"
    ;;
  revoke)
    if ! id "$user" >/dev/null 2>&1; then
      echo "not found" >&2
      exit 1
    fi
    gpasswd -d "$user" engineroom-users
    ;;
  *)
    echo "usage: engineroom-admin add|revoke USER" >&2
    exit 1
    ;;
esac
