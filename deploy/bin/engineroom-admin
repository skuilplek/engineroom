#!/bin/bash
# Create a Linux account, change its password, or delete the account and keep the home.
# The hub is the only caller, via sudo. Password for add and passwd is one line on stdin.
set -euo pipefail

action="${1:-}"
user="${2:-}"
hub_env="${ENGINEROOM_HUB_ENV:-/etc/engineroom/hub.env}"

if [[ ! "$user" =~ ^[a-zA-Z_][a-zA-Z0-9_-]{0,31}$ ]]; then
  echo "invalid username" >&2
  exit 1
fi

admin=""
if [[ -f "$hub_env" ]]; then
  admin="$(sed -n 's/^ENGINEROOM_ADMIN=//p' "$hub_env" | head -n 1 | tr -d '[:space:]')"
fi

if [[ "$user" == "root" || "$user" == "engineroom" || ( -n "$admin" && "$user" == "$admin" ) ]]; then
  echo "must not change this account" >&2
  exit 1
fi

if id "$user" >/dev/null 2>&1; then
  uid="$(id -u "$user")"
  if (( uid < 1000 )); then
    echo "must not change this account" >&2
    exit 1
  fi
fi

if [[ "$(id -u)" -ne 0 ]]; then
  echo "must run as root" >&2
  exit 1
fi

# The hub service mounts the system read-only, and sudo stays in that mount
# namespace. useradd then fails with "cannot lock /etc/passwd". Continue in
# the host mount namespace, where /etc and /home can be updated.
if [[ "${ENGINEROOM_ADMIN_NS:-}" != "host" ]]; then
  self_mnt="$(readlink /proc/self/ns/mnt 2>/dev/null || true)"
  init_mnt="$(readlink /proc/1/ns/mnt 2>/dev/null || true)"
  if [[ -n "$self_mnt" && -n "$init_mnt" && "$self_mnt" != "$init_mnt" ]]; then
    export ENGINEROOM_ADMIN_NS=host
    exec nsenter -t 1 -m -- "$0" "$@"
  fi
fi

case "$action" in
  add)
    IFS= read -r password || true
    if [[ -z "${password}" || "$password" == *$'\n'* ]]; then
      echo "password is empty" >&2
      exit 1
    fi
    created=0
    if ! id "$user" >/dev/null 2>&1; then
      useradd --create-home --shell /bin/bash "$user"
      created=1
    fi
    uid="$(id -u "$user")"
    if (( uid < 1000 )); then
      echo "must not change this account" >&2
      exit 1
    fi
    printf '%s:%s\n' "$user" "$password" | chpasswd
    usermod -aG engineroom-users "$user"
    if (( created )); then
      # A re-added account can already have a home left from the previous
      # Linux user. Only a newly created account should take ownership of it;
      # an existing account keeps whatever homes and mounts it already has.
      home="$(getent passwd "$user" | cut -d: -f6)"
      case "$home" in
        /*/*)
          if [[ -d "$home" && "$home" != "/root" ]]; then
            chown -R "${user}:" "$home" || echo "could not change home ownership for ${user}" >&2
          fi
          ;;
      esac
    fi
    # Make the account usable right away. The hub would also start this on
    # first sign-in, but doing it here means selecting the new user in the
    # admin panel does not depend on a later login. A missing or failed unit
    # is not fatal: the normal runner-start path can still create it.
    if command -v systemctl >/dev/null 2>&1; then
      systemctl reset-failed "engineroom-runner@${user}.service" "engineroom-runner@${user}.socket" >/dev/null 2>&1 || true
      systemctl start "engineroom-runner@${user}.socket" >/dev/null 2>&1 || true
    fi
    ;;
  passwd)
    IFS= read -r password || true
    if [[ -z "${password}" || "$password" == *$'\n'* ]]; then
      echo "password is empty" >&2
      exit 1
    fi
    if ! id "$user" >/dev/null 2>&1; then
      echo "not found" >&2
      exit 1
    fi
    printf '%s:%s\n' "$user" "$password" | chpasswd
    ;;
  revoke)
    if ! id "$user" >/dev/null 2>&1; then
      echo "not found" >&2
      exit 1
    fi
    gpasswd -d "$user" engineroom-users
    ;;
  remove)
    if ! id "$user" >/dev/null 2>&1; then
      echo "not found" >&2
      exit 1
    fi
    uid="$(id -u "$user")"
    systemctl stop "engineroom-runner@${user}.service" "engineroom-runner@${user}.socket" || true
    if [[ -n "$uid" ]]; then
      pkill -KILL -u "$uid" || true
    fi
    userdel "$user"
    ;;
  *)
    echo "usage: engineroom-admin add|passwd|revoke|remove USER" >&2
    exit 1
    ;;
esac
